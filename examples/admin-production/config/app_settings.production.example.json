{
  "adapters": {
    "typeorm": {
      "host": "database.example.invalid",
      "port": 5432,
      "database": "replace-with-database-name",
      "username": "replace-with-database-user",
      "password": "replace-with-database-password",
      "poolSize": 10
    },
    "platform-admin": {
      "allowedPublicOrigin": "https://admin.example.invalid",
      "bootstrap": {
        "displayName": "Replace with administrator name",
        "email": "admin@example.invalid",
        "password": "replace-with-a-unique-bootstrap-password"
      },
      "cookie": {
        "name": "__Host-prosto-admin",
        "lifetimeSeconds": 3600,
        "secure": true
      },
      "outbox": {
        "leaseSeconds": 60,
        "maxAttempts": 5,
        "retryBaseSeconds": 30
      },
      "rateLimit": {
        "login": {
          "maxAttempts": 10,
          "windowSeconds": 900
        },
        "passwordReset": {
          "maxAttempts": 5,
          "windowSeconds": 3600
        }
      },
      "resetTokenEncryptionKey": "replace-with-a-base64url-encoded-32-byte-key",
      "resetUrlBase": "https://admin.example.invalid/reset-password",
      "restartPollingIntervalSeconds": 5,
      "smtp": {
        "host": "smtp.example.invalid",
        "port": 465,
        "secure": true,
        "from": "admin@example.invalid"
      },
      "trustedIngressConfigured": true
    }
  }
}
