{
  "name": "@prosto/platform-core",
  "version": "0.0.0",
  "description": "Minimal micro-core runtime kernel for Prosto platform",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prosto/platform-sdk": "0.0.0"
  }
}
