{
  "name": "@prosto/platform-core",
  "version": "0.0.0",
  "description": "Minimal micro-core runtime kernel for Prosto platform",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.package.json",
    "typecheck": "tsc -p tsconfig.package.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@prosto/platform-sdk": "0.0.0"
  },
  "devDependencies": {
    "@internal/tsconfig": "*",
    "@tsconfig/node22": "^22.0.5",
    "vitest": "^4.1.2"
  }
}
