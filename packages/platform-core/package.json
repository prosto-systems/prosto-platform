{
  "name": "@prosto/platform-core",
  "version": "0.0.0",
  "description": "Minimal micro-core runtime kernel for Prosto platform",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "app_settings.json",
    "app_settings.development.json",
    "app_settings.production.json"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.package.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@prosto/platform-sdk": "0.0.0",
    "adm-zip": "^0.5.17",
    "tar": "^7.5.15",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@internal/tsconfig": "*",
    "@tsconfig/node22": "^22.0.5",
    "@types/adm-zip": "^0.5.5",
    "vite": "^8.0.14",
    "vite-plugin-dts": "^5.0.1",
    "vitest": "^4.1.7"
  }
}
