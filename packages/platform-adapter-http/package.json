{
  "name": "@prosto/platform-adapter-http",
  "version": "0.0.0",
  "description": "HTTP transport adapter surface for Prosto platform",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
