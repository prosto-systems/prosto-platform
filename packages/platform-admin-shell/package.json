{
  "name": "@prosto/platform-admin-shell",
  "version": "0.0.0",
  "description": "Admin shell with Vue 3 plugin runtime for Prosto platform",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --open",
    "build": "run-p typecheck \"build:only {@}\" --",
    "build:only": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build --force",
    "test": "vitest run",
    "test:unit": "vitest run --reporter=verbose"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.2.10",
    "@mdi/font": "7.4.47",
    "@prosto/platform-sdk": "0.0.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0",
    "vuetify": "^4.1.10"
  },
  "devDependencies": {
    "@prosto/platform-tsconfig": "^0.0.0",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.0",
    "@vuetify/mcp": "^0.9.1",
    "happy-dom": "^20.11.2",
    "npm-run-all2": "^8.0.4",
    "sass-embedded": "^1.98.0",
    "typescript": "^6.0.3",
    "unplugin-fonts": "^2.0.0",
    "vite": "^8.2.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.7",
    "vue-tsc": "^3.3.4"
  }
}
