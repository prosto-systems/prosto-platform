{
  "extends": "@prosto/platform-tsconfig/base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node", "vite/client", "@prosto/platform-sdk/admin"]
  },
  "include": [
    "env.d.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "tests/**/*.ts"
  ]
}
