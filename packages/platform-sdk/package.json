{
  "name": "@prosto/platform-sdk",
  "version": "0.0.0",
  "description": "Contract authority for Prosto platform modules and adapters",
  "type": "module",
  "private": false,
  "exports": {
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "import": "./dist/admin.js"
    },
    "./admin/http": {
      "types": "./dist/admin/http/index.d.ts",
      "import": "./dist/admin/http.js"
    },
    "./platform": {
      "types": "./dist/platform/index.d.ts",
      "import": "./dist/platform.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.package.json --noEmit",
    "test": "npm run test:types && npm run test:unit",
    "test:types": "tsc -p tsconfig.type-tests.json --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "semver": "^7.7.4",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@prosto/platform-tsconfig": "^0.0.0",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^22.20.1",
    "@types/semver": "^7.7.1",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.1",
    "vitest": "^4.1.7",
    "vue-router": "^5.2.0"
  }
}
