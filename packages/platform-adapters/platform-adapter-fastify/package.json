{
  "name": "@prosto/platform-adapter-fastify",
  "version": "0.0.0",
  "description": "Fastify HTTP application adapter for Prosto Platform",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.package.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.1",
    "@prosto/platform-sdk": "^0.0.0",
    "fastify": "^5.12.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@prosto/platform-tsconfig": "^0.0.0",
    "@tsconfig/node22": "^22.0.5",
    "vite": "^8.1.3",
    "vite-plugin-dts": "^5.0.1",
    "vitest": "^4.1.7"
  }
}
