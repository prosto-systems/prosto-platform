{
  "name": "@prosto/platform-module-admin",
  "version": "0.0.0",
  "description": "Production administration module for Prosto Platform",
  "type": "module",
  "private": false,
  "main": "./dist/platform.module.js",
  "types": "./dist/platform/platform.module.d.ts",
  "exports": {
    "./platform": {
      "types": "./dist/platform/platform.module.d.ts",
      "import": "./dist/platform.module.js"
    }
  },
  "files": [
    "dist",
    "manifest.json"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.package.json --noEmit",
    "test": "vitest run",
    "test:contracts": "vitest run tests/contracts.test.ts"
  },
  "dependencies": {
    "@prosto/platform-adapter-typeorm": "^0.0.0",
    "@prosto/platform-sdk": "^0.0.0",
    "nodemailer": "^7.0.12",
    "typeorm": "^1.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@prosto/platform-contract-tests": "^0.0.0",
    "@prosto/platform-tsconfig": "^0.0.0",
    "@tsconfig/node22": "^22.0.5",
    "@types/nodemailer": "^7.0.11",
    "@types/node": "^22.20.1",
    "better-sqlite3": "^12.11.1",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.1",
    "vitest": "^4.1.7"
  }
}
