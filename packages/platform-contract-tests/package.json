{
  "name": "@prosto/platform-contract-tests",
  "version": "0.0.0",
  "description": "Reusable contract conformance package for Prosto modules",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.package.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@prosto/platform-sdk": "0.0.0"
  },
  "devDependencies": {
    "@prosto/platform-tsconfig": "^0.0.0",
    "@tsconfig/node22": "^22.0.5",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.1",
    "vitest": "^4.1.7"
  }
}
